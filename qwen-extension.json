{
  "name": "ui-code-generator",
  "version": "1.0.4",
  "skills": "skills",
  "mcpServers": {
    "ui-generator-mcp": {
      "httpUrl": "http://localhost:3000/sse",
      "timeout": 30000,
      "oauth": {
        "enabled": true,
        "clientId": "mcp-server",
        "authorizationUrl": "https://data.agentport.ru/auth/realms/dataspace/protocol/openid-connect/auth",
        "tokenUrl": "https://data.agentport.ru/auth/realms/dataspace/protocol/openid-connect/token",
        "redirectUri": "http://localhost:7777/oauth/callback",
        "scopes": [
          "profile"
        ]
      }
    },
    "plasma-web": {
      "command": "npx",
      "args": [
        "-y",
        "@salutejs/sdds-mcp@latest",
        "--lib",
        "plasma-web",
        "--version",
        "latest"
      ],
      "timeout": 60000
    }
  }
}